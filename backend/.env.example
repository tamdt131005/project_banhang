# ============================================================
# Sao chép file này thành .env rồi sửa cho khớp máy bạn:
#   copy backend\.env.example backend\.env
# ============================================================

# ---- Database ----
# Laragon mặc định: user "root", mật khẩu rỗng, cổng 3306.
# Nếu bạn đặt mật khẩu cho root thì điền vào sau dấu hai chấm:
#   mysql://root:matkhau@localhost:3306/agentchuan_shop
DATABASE_URL="mysql://root:@localhost:3306/agentchuan_shop"

# Database riêng cho `npm test`. Test sẽ XOÁ SẠCH dữ liệu trong database này
# trước mỗi lần chạy, nên tuyệt đối không trỏ vào database thật.
TEST_DATABASE_URL="mysql://root:@localhost:3306/agentchuan_shop_test"

# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- JWT ----
# Sinh chuỗi ngẫu nhiên bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=doi_chuoi_nay_thanh_ngau_nhien_truoc_khi_chay_that__access
JWT_REFRESH_SECRET=doi_chuoi_nay_thanh_ngau_nhien_truoc_khi_chay_that__refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- Upload ảnh ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Đơn hàng ----
# Phí vận chuyển cố định, đơn vị VND
SHIPPING_FEE=30000

# ---- AI chat via OpenAI-compatible router (server-side only) ----
# Khong dua key nay sang frontend. De tat AI: AI_CHAT_ENABLED=false
AI_CHAT_ENABLED=false
CUSTOM_AI_BASE_URL=http://localhost:20128/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gemini/gemma-4-31b-it
AI_CHAT_TIMEOUT_MS=15000
AI_CHAT_MAX_TOOL_ITERATIONS=5
AI_CHAT_CONTEXT_MESSAGES=16
AI_CHAT_STALE_MS=120000

# ---- MoMo (để trống thì chỉ dùng được COD) ----
# Lấy partnerCode/accessKey/secretKey sandbox tại https://developers.momo.vn
# (bộ khoá test công khai trong tài liệu hoặc tài khoản business sandbox).
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
# Gốc API, không kèm đường dẫn. Production: https://payment.momo.vn
MOMO_ENDPOINT=https://test-payment.momo.vn
# Trang frontend nhận khách quay về sau khi thanh toán.
MOMO_REDIRECT_URL=http://localhost:5173/thanh-toan/momo/ket-qua
# MoMo chỉ gọi IPN tới địa chỉ công khai (vd. qua tunnel). Để localhost thì
# trang kết quả tự tra cứu giao dịch nên vẫn chạy được.
MOMO_IPN_URL=http://localhost:4000/api/payments/momo/ipn
# ---- Email OTP registration and password reset ----
# Configure with your SMTP provider. Generate a different HMAC secret for each app:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_OTP_HMAC_SECRET=replace_with_a_random_64_character_secret
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
